{
  "name": "lever",
  "productName": "Lever",
  "version": "0.3.0",
  "description": "Control station (interlocking) for model railways on a Z21-compatible central unit",
  "main": "out/main/index.js",
  "private": true,
  "license": "MIT",
  "author": "Alppirautatieharrastajat ry",
  "homepage": "https://github.com/MatteZ02/lever#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MatteZ02/lever.git"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "start": "electron-vite preview",
    "lint": "eslint . && node scripts/check-css-colors.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "fake-z21": "node scripts/fake-z21.mjs --port=21107",
    "dist": "npm run build && electron-builder --win",
    "dist:dir": "npm run build && electron-builder --win --dir"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zustand": "5.1.0",
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "electron": "45.3.3",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import-x": "4.18.1",
    "eslint-plugin-prettier": "5.5.7",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
