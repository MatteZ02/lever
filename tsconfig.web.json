{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.cache/tsconfig.web.tsbuildinfo",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vitest/globals"]
  },
  "include": [
    "src/renderer/**/*",
    "src/preload/api.ts",
    "src/model/**/*",
    "src/shared/**/*",
    "packages/*/src/**/*"
  ]
}
